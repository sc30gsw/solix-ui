{
  "name": "solix-ui",
  "private": true,
  "license": "MIT",
  "type": "module",
  "imports": {
    "#/*": "./*"
  },
  "scripts": {
    "build:packages": "NODE_ENV=production vp run -r build",
    "check:lockfile": "pnpm install --frozen-lockfile --lockfile-only",
    "check:private-terms": "node scripts/check-private-terms.mjs",
    "e2e": "E2E_TELEMETRY_DISABLED=1 e2e",
    "lint:solid": "solid2-kit check . apps/storybook/.storybook apps/storybook/fixtures/.storybook && solid2-kit doctor",
    "migrate:subpath-imports": "node scripts/migrate-to-subpath-imports.ts",
    "prepare": "vp config --no-agent",
    "test:e2e": "vp run build:packages && vp run e2e run",
    "verify": "vp run check:lockfile && vp check --deny-warnings && vp run lint:solid && vp run check:private-terms && vp run build:packages && SOLIX_PACKAGES_BUILT=production vp test && vp run e2e run",
    "web-guidance": "DISABLE_TELEMETRY=1 modern-web-guidance"
  },
  "devDependencies": {
    "@e2e-dev/web": "catalog:",
    "@solidjs/vite-plugin": "catalog:",
    "@solidjs/web": "catalog:",
    "@types/node": "catalog:",
    "@types/semver": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "axe-core": "catalog:",
    "e2e": "catalog:",
    "fast-check": "catalog:",
    "modern-web-guidance": "catalog:",
    "playwright": "catalog:",
    "postcss": "catalog:",
    "postcss-value-parser": "catalog:",
    "semver": "catalog:",
    "solid-js": "catalog:",
    "solid2-agent-kit": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "yaml": "catalog:"
  },
  "engines": {
    "node": "^26.13.1"
  },
  "packageManager": "pnpm@12.22.0"
}
