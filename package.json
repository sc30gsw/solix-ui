{
  "name": "solix-ui",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "check:private-terms": "node scripts/check-private-terms.mjs",
    "evidence": "node .agents/skills/verify-playground/scripts/evidence.mjs",
    "lint:solid": "solid2-kit check --dir . && solid2-kit doctor",
    "prepare": "vp config --no-agent",
