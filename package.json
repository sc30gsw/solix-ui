    "web-guidance": "DISABLE_TELEMETRY=1 modern-web-guidance"
  },
  "devDependencies": {
    "@solidjs/vite-plugin": "catalog:",
    "@solidjs/web": "catalog:",
    "@types/node": "catalog:",
    "@types/semver": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "axe-core": "catalog:",
    "fast-check": "catalog:",
    "modern-web-guidance": "catalog:",
    "playwright": "catalog:",
    "postcss": "catalog:",
    "semver": "catalog:",
    "solid-js": "catalog:",
    "solid2-agent-kit": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": "^26.13.1"
  },
  "packageManager": "pnpm@12.21.0"
}
