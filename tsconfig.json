{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "allowJs": true
  },
  "include": [
    "vite.config.ts",
    "tests",
    "scripts",
    "packages/*/tests",
    "packages/*/fixtures",
    "packages/*/spec",
    "apps/*/tests",
    "packages/*/build-pipeline.mjs"
  ],
  "exclude": ["tests/fixtures"]
}
