{
  "enabledPlugins": {
    "pstack@cursor-plugins": true,
    "modern-web-guidance@googlechrome": true
  },
  "extraKnownMarketplaces": {
    "cursor-plugins": {
      "source": {
        "source": "github",
        "repo": "cursor/plugins"
      }
    },
    "googlechrome": {
      "source": {
        "source": "github",
        "repo": "GoogleChrome/modern-web-guidance"
      }
    }
  },
  "env": {
    "DISABLE_TELEMETRY": "1"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/agent-command-guard.ts\" || { echo \"The command guard did not run, so the command is refused.\" >&2; exit 2; }"
          }
        ]
      }
    ]
  }
}
